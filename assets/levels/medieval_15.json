  "lines": [
    {
      "trigger": "start",
      "speaker": "blackBaron",
      "text": "So the desert rat has come to my door. Look well at the Black Keep, Arslan. No one has crossed its moat and lived."
    },
    {
      "trigger": "volley:1",
      "speaker": "bashir",
      "text": "Engines behind the moat, in the outer bailey! Silence them before they find the barricade."
    },
    {
      "trigger": "volley:2",
      "speaker": "roxana",
      "text": "The drawbridge hangs on one chain from the gatehouse. Bring the wall down and the bridge falls."
    },
    {
      "trigger": "phase:2",
      "speaker": "blackBaron",
      "text": "Raise the curtain walls! Every man to the battlements."
    },
    {
      "trigger": "volley:5",
      "speaker": "titus",
      "text": "Their archers stand on bare stone. Knock the towers from under them."
    },
    {
      "trigger": "phase:3",
      "speaker": "blackBaron",
      "text": "Enough. The Crown gave me this keep, and I will hold it with my own hands."
    },
    {
      "trigger": "volley:8",
      "speaker": "arslan",
      "text": "His roof is timber over stone. Burn it, and there is nowhere left for him to hide."
    }
  ],
