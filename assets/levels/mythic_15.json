  "lines": [
    {
      "trigger": "start",
      "speaker": "ironKing",
      "text": "Six ages you crossed to reach my door, mason. Look up. No engine ever built has thrown a stone this high."
    },
    {
      "trigger": "volley:1",
      "speaker": "bashir",
      "text": "Engines on both banks of the moat! Silence the near one before it finds the barricade."
    },
    {
      "trigger": "volley:2",
      "speaker": "roxana",
      "text": "The drawbridge hangs on one chain from the gatehouse. Bring the wall down and the bridge comes with it."
    },
    {
      "trigger": "phase:2",
      "speaker": "ironKing",
      "text": "Rise, my tower! Let the storm carry them off the mountain."
    },
    {
      "trigger": "volley:5",
      "speaker": "titus",
      "text": "Their men walk a bridge of crystal between the towers. Crystal is hard, but it shatters. Break it under them."
    },
    {
      "trigger": "phase:3",
      "speaker": "ironKing",
      "text": "Enough. I will take the last shard from your corpse myself."
    },
    {
      "trigger": "volley:8",
      "speaker": "liWei",
      "text": "His chamber stands on one marble slab over an open hall. The engineer down there will patch every crack we make, unless we get him first."
    },
    {
      "trigger": "volley:10",
      "speaker": "bashir",
      "text": "Every mason leaves one stone loose, General. Look at the far pillar of his chamber."
    }
  ],
