  "lines": [
    {
      "trigger": "start",
      "speaker": "shahbanu",
      "text": "You have come a long way to die among my roses, Arslan. The Iron Crown sends its greetings."
    },
    {
      "trigger": "volley:1",
      "speaker": "bashir",
      "text": "Engines among the flower beds! Silence them before they find the barricade."
    },
    {
      "trigger": "volley:2",
      "speaker": "arslan",
      "text": "Hold the barricade. We did not cross the desert to fall in a garden."
    },
    {
      "trigger": "phase:2",
      "speaker": "shahbanu",
      "text": "Raise the terraces! Let my gardens float above the dust."
    },
    {
      "trigger": "volley:5",
      "speaker": "titus",
      "text": "Stone on stone, like any wall. Knock the tiers out and the rest comes down."
    },
    {
      "trigger": "phase:3",
      "speaker": "shahbanu",
      "text": "Enough. The Crown gave me this garden, and I will keep it myself."
    },
    {
      "trigger": "volley:8",
      "speaker": "roxana",
      "text": "That great dome is only glazed tile, and there is powder beside her. One good hit, Arslan."
    }
  ],
