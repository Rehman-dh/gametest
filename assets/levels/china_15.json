  "lines": [
    {
      "trigger": "start",
      "speaker": "warlordTao",
      "text": "Ten thousand li of stone, Arslan, and every li of it is mine. Turn back while you still have a road behind you."
    },
    {
      "trigger": "volley:1",
      "speaker": "liWei",
      "text": "Two engines below the Wall, and a powder store beside the far one. Tao always keeps his powder too close."
    },
    {
      "trigger": "volley:2",
      "speaker": "arslan",
      "text": "Hold the barricade. We have come too far to be stopped at a gate."
    },
    {
      "trigger": "phase:2",
      "speaker": "warlordTao",
      "text": "Man the Wall! Every tower, every bow. Let them break themselves on it."
    },
    {
      "trigger": "volley:5",
      "speaker": "titus",
      "text": "Their archers stand on bare parapets. Knock the stone from under them."
    },
    {
      "trigger": "phase:3",
      "speaker": "warlordTao",
      "text": "Enough. The Crown gave me this gate, and I will hold it with my own sword."
    },
    {
      "trigger": "volley:7",
      "speaker": "bashir",
      "text": "He stands in the gate passage with a powder keg at his side. Get a stone in there!"
    },
    {
      "trigger": "volley:9",
      "speaker": "roxana",
      "text": "The gatehouse sits on two piers. Break the near one and the whole pagoda comes down on him."
    }
  ],
