    {
      "trigger": "start",
      "speaker": "bashir",
      "text": "The storm road is the only way up to the Titan Tower, and the Legion has closed it with three engines. One on our side of the moat, two beyond it."
    },
    {
      "trigger": "volley:1",
      "speaker": "ironKing",
      "text": "Every road in the world ends at my door, Arslan. This one ends in the rain."
    },
    {
      "trigger": "volley:2",
      "speaker": "titus",
      "text": "An engineer is patching their works across the water. Put him down, or every crack we make is wasted."
    },
    {
      "trigger": "volley:4",
      "speaker": "roxana",
      "text": "The engine on the wall has our range. There is powder behind that wall. Light it!"
    }
