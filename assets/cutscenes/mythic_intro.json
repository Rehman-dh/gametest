    {
      "type": "say",
      "speaker": "bashir",
      "text": "Look closer. Egyptian stone, Roman brick, Persian tile, all torn loose and stacked together."
    },
    {
      "type": "say",
      "speaker": "bashir",
      "text": "Someone built this realm from the ruins of every kingdom we crossed."
    },
