      "type": "pose",
      "actor": "titus",
      "pose": "talk"
    },
    {
      "type": "say",
      "speaker": "titus",
      "text": "Lightning with no rain. Wind with no direction. I do not trust a storm that cannot make up its mind."
    },
    {
      "type": "pose",
      "actor": "titus",
      "pose": "stand"
    },
