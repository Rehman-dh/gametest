    {
      "type": "say",
      "speaker": "hero",
      "text": "Tell your queen I did not cross the sea to be frightened by the wind."
    },
    {
      "type": "say",
      "speaker": "hero",
      "text": "She holds a woman named Roxana. I will have her free, and I will have the shard."
    },
