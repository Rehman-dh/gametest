    {
      "type": "sound",
      "sound": "weakPoint"
    },
    {
      "type": "say",
      "speaker": "hero",
      "text": "Another shard. And it hums, as if it knows the others are near."
    },
    {
      "type": "pose",
      "actor": "hero",
      "pose": "stand"
    },
    {
      "type": "camera",
