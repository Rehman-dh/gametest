    {
      "type": "say",
      "speaker": "bashir",
      "text": "The Floating Gardens. Terrace upon terrace, and every one of them a wall with flowers on it."
    },
    {
      "type": "camera",
      "x": 12,
      "y": -2,
      "viewHeight": 8,
      "duration": 2.5
