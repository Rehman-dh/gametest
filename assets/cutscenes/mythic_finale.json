      "pose": "talk"
    },
    {
      "type": "say",
      "speaker": "ironhand",
      "text": "The voice in the iron... it is gone. For the first time in thirty years, my head is quiet."
    },
    {
      "type": "pose",
      "actor": "ironhand",
      "pose": "stand"
    },
    {
      "type": "pose",
      "actor": "hero",
      "pose": "talk",
      "facing": 1
    },
    {
      "type": "say",
      "speaker": "hero",
      "text": "You killed my master."
    },
    {
      "type": "say",
      "speaker": "ironhand",
      "text": "I did. And now there is no crown to take the memory from me."
    },
    {
      "type": "say",
      "speaker": "hero",
      "text": "Then live, and remember. It is more than you gave him."
    },
    {
      "type": "pose",
      "actor": "hero",
      "pose": "stand"
    },
    {
      "type": "pose",
      "actor": "ironhand",
