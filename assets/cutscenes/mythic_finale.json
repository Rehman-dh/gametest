    },
    {
      "type": "say",
      "speaker": "titus",
      "text": "Young men come to me in Rome and ask me to teach them to fight. I teach them to build first."
    },
    {
      "type": "pose",
      "actor": "titus",
      "pose": "stand"
    },
    {
      "type": "pose",
      "actor": "roxana",
