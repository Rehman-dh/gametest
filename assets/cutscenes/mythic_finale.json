      "type": "pose",
      "actor": "roxana",
      "pose": "stand"
    },
    {
      "type": "pose",
      "actor": "liwei",
      "pose": "talk"
    },
    {
      "type": "say",
      "speaker": "liwei",
      "text": "And I am drawing the first honest map of the world. Every road open. No wall marked forbidden."
    },
    {
      "type": "pose",
      "actor": "liwei",
      "pose": "stand"
    },
    {
      "type": "pose",
      "actor": "hero",
      "pose": "talk"
    },
    {
      "type": "say",
      "speaker": "hero",
      "text": "Garin would have liked that map."
    },
    {
      "type": "pose",
      "actor": "hero",
      "pose": "stand"
    },
