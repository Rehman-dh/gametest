    {
      "type": "say",
      "speaker": "hero",
      "text": "The cage is broken. Can you stand?"
    },
    {
      "type": "pose",
      "actor": "liwei",
      "pose": "stand"
    },
    {
      "type": "move",
      "actor": "liwei",
      "x": 3.2,
